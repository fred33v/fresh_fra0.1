+// A bare `*` is an unbounded wildcard (`[^/]*?`). Repeating a branch that contains one,
+// such as `+(*a)` or `*(a*b)`, nests two unbounded quantifiers, so a failed match
+// backtracks exponentially. A `*` that opens a nested extglob (`*(`) is left to the
+// recursion check.
+const hasBareStar = branch => {
+  let bracket = 0;
+  let quote = 0;
+
+  for (let i = 0; i < branch.length; i++) {
+    const ch = branch[i];
+
+    if (ch === '\\') {
+      i++;
+      continue;
+    }
+
+    if (ch === '"') {
+      quote = quote === 1 ? 0 : 1;
+      continue;
+    }
+
+    if (quote === 1) {
+      continue;
+    }
+
+    if (ch === '[') {
+      bracket++;
+      continue;
+    }
+
+    if (ch === ']' && bracket > 0) {
+      bracket--;
+      continue;
+    }
+
+    if (bracket === 0 && ch === '*' && branch[i + 1] !== '(') {
+      return true;
+    }
+  }
+
+  return false;
+};
