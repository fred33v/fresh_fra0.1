diff --git a/build/fork/safeQueryString.js b/build/fork/safeQueryString.js
new file mode 100644
index 0000000000000000000000000000000000000000..e3564b6063dceb8e99bf309a4c3c5690e6dc92c0
--- /dev/null
+++ b/build/fork/safeQueryString.js
@@ -0,0 +1,63 @@
+"use strict";
+
+// Compatible with query-string 7's default stringify behaviour,
+// including the { sort: false } option used by Expo Router.
+function stringify(object, options = {}) {
+  if (!object) return "";
+
+  const settings = {
+    encode: true,
+    strict: true,
+    skipNull: false,
+    skipEmptyString: false,
+    sort: true,
+    ...options
+  };
+
+  const encode = value => {
+    const text = String(value);
+    if (!settings.encode) return text;
+
+    const encoded = encodeURIComponent(text);
+    return settings.strict
+      ? encoded.replace(/[!'()*]/g, character =>
+          "%" + character.charCodeAt(0).toString(16).toUpperCase()
+        )
+      : encoded;
+  };
+
+  const keys = Object.keys(object).filter(key =>
+    !(settings.skipNull && object[key] == null) &&
+    !(settings.skipEmptyString && object[key] === "")
+  );
+
+  if (settings.sort !== false) keys.sort(settings.sort);
+
+  const parts = [];
+
+  for (const key of keys) {
+    const value = object[key];
+    if (value === undefined) continue;
+
+    const encodedKey = encode(key);
+
+    if (value === null) {
+      parts.push(encodedKey);
+    } else if (Array.isArray(value)) {
+      for (const item of value) {
+        if (item === undefined || (settings.skipNull && item === null) ||
+            (settings.skipEmptyString && item === "")) continue;
+
+        parts.push(item === null
+          ? encodedKey
+          : encodedKey + "=" + encode(item));
+      }
+    } else {
+      parts.push(encodedKey + "=" + encode(value));
+    }
+  }
+
+  return parts.join("&");
+}
+
+module.exports = { stringify };
