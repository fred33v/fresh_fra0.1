+	    }
+
+	    if (ch === '[') {
+	      bracket++;
+	      continue;
+	    }
+
+	    if (ch === ']' && bracket > 0) {
+	      bracket--;
+	      continue;
+	    }
+
+	    if (bracket === 0 && ch === '*' && branch[i + 1] !== '(') {
+	      return true;
+	    }
+	  }
+
+	  return false;
+	};
+
 	const analyzeRepeatedExtglob = (body, options) => {
 	  if (options.maxExtglobRecursion === false) {
 	    return { risky: false };
