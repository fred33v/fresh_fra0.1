{
  "name": "@stopfra/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src",
    "test": "jest -c jest.config.cjs",
    "test:coverage": "jest -c jest.config.cjs --coverage --forceExit",
    "test:watch": "jest -c jest.config.cjs --watch"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@hono/node-server": "^1.19.17",
    "@upstash/redis": "^1.34.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "hono": "^4.13.13",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.14",
    "pg": "^8.13.1",
    "puppeteer": "^24.43.1",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
