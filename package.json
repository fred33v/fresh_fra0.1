{
  "name": "@stopfra/monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Stop FRA - Fraud Risk Assessment Platform Monorepo",
  "scripts": {
    "dev:mobile": "pnpm --filter @stopfra/mobile-app start",
    "dev:web": "pnpm --filter @stopfra/web-dashboard dev",
    "dev:backend": "pnpm --filter @stopfra/backend dev",
    "dev:training": "pnpm --filter @stopfra/training-app start",
    "dev:budget": "pnpm --filter @stopfra/budget-guide start",
    "build": "turbo run build",
    "build:web": "pnpm --filter @stopfra/web-dashboard build",
    "build:backend": "pnpm --filter @stopfra/backend build",
    "preview": "pnpm --filter @stopfra/web-dashboard preview",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @stopfra/web-dashboard test:e2e",
    "test:security": "node --test tests/security/*.test.cjs",
    "test:backend": "pnpm --filter @stopfra/backend test",
    "db:migrate": "pnpm --filter @stopfra/backend migrate",
    "clean": "rm -rf node_modules apps/*/node_modules apps/fra-backend/backend/node_modules",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.11.11",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@types/react": ">=18.0.0"
      }
    },
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "@remix-run/router": ">=7.7.0",
      "lodash": ">=4.18.0",
      "tar@7": "^7.5.21",
      "shell-quote": "^1.9.0",
      "@xmldom/xmldom@0.8": "^0.8.15",
      "undici@6": "^6.28.1",
      "ws@8": "^8.21.0",
      "ws@7": "^7.5.11",
      "postcss@8": "^8.5.23",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "compression": "^1.8.2",
      "source-map-js": "^1.2.2",
      "browserslist": "^4.28.7",
      "ip-address": "^10.7.1",
      "picomatch@2": "^2.3.2",
      "picomatch@3": "^3.0.2",
      "picomatch@4": "^4.0.4",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "ws@6": "^6.2.4",
      "node-forge": "^1.4.3",
      "basic-ftp@5": "^5.3.1",
      "handlebars": "4.7.10",
      "@react-navigation/core@7": "7.24.0",
      "postcss-selector-parser@6": "^6.1.5",
      "yaml@2": "^2.8.3",
      "@babel/core@7": "^7.29.6",
      "metro@0.83.3>image-size": "-",
      "@expo/config-plugins>xcode": "4.0.0",
      "@expo/cli>glob": "14.0.2",
      "@expo/config>glob": "14.0.2",
      "@expo/config-plugins>glob": "14.0.2",
      "@expo/metro-config>glob": "14.0.2",
      "@expo/fingerprint>glob": "14.0.2",
      "@expo/cli>minimatch": "11.0.5",
      "@expo/fingerprint>minimatch": "11.0.5",
      "@typescript-eslint/typescript-estree>minimatch": "11.0.5",
      "@expo/ngrok>uuid": "^11.1.1",
      "undici@7": "^7.30.1",
      "flatted@3": "^3.4.2",
      "form-data@4": "^4.0.6",
      "ajv@6": "^6.14.0",
      "yaml@1": "^1.10.3",
      "@tootallnate/once@2": "^2.0.1",
      "@humanfs/node@0.16": "^0.16.8",
      "@babel/plugin-transform-modules-systemjs@7": "^7.29.4"
    },
    "patchedDependencies": {
      "expo-router@6.0.23": "patches/expo-router@6.0.23.patch",
      "metro@0.83.3": "patches/metro@0.83.3.patch",
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
