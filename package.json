{
  "name": "@stopfra/monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Stop FRA - Fraud Risk Assessment Platform Monorepo",
  "scripts": {
    "dev:mobile": "pnpm --filter @stopfra/mobile-app start",
    "dev:web": "pnpm --filter @stopfra/web-dashboard dev",
    "dev:backend": "pnpm --filter @stopfra/backend dev",
    "dev:training": "pnpm --filter @stopfra/training-app start",
    "dev:budget": "pnpm --filter @stopfra/budget-guide start",
    "build": "turbo run build",
    "build:web": "pnpm --filter @stopfra/web-dashboard build",
    "build:backend": "pnpm --filter @stopfra/backend build",
    "preview": "pnpm --filter @stopfra/web-dashboard preview",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @stopfra/web-dashboard test:e2e",
    "test:backend": "pnpm --filter @stopfra/backend test",
    "db:migrate": "pnpm --filter @stopfra/backend migrate",
    "clean": "rm -rf node_modules apps/*/node_modules apps/fra-backend/backend/node_modules",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@types/react": ">=18.0.0"
      }
    },
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "@remix-run/router": ">=7.7.0",
      "lodash": ">=4.18.0",
      "tar@7": "^7.5.21",
      "shell-quote": "^1.9.0",
      "@xmldom/xmldom@0.8": "^0.8.15",
      "undici@6": "^6.28.1",
      "ws@8": "^8.21.0",
      "ws@7": "^7.5.11",
      "postcss@8": "^8.5.23",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "compression": "^1.8.2",
      "source-map-js": "^1.2.2",
      "browserslist": "^4.28.7",
      "ip-address": "^10.7.1",
      "picomatch@2": "^2.3.2",
      "picomatch@3": "^3.0.2",
      "picomatch@4": "^4.0.4",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "ws@6": "^6.2.4",
      "node-forge": "^1.4.0",
      "basic-ftp@5": "^5.3.1",
      "handlebars": "4.7.10"
    }
  }
}
