{
  "name": "@stopfra/monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Stop FRA - Fraud Risk Assessment Platform Monorepo",
  "scripts": {
    "dev:mobile": "pnpm --filter @stopfra/mobile-app start",
    "dev:web": "pnpm --filter @stopfra/web-dashboard dev",
    "dev:backend": "pnpm --filter @stopfra/backend dev",
    "dev:training": "pnpm --filter @stopfra/training-app start",
    "dev:budget": "pnpm --filter @stopfra/budget-guide start",
    "build": "turbo run build",
    "build:web": "pnpm --filter @stopfra/web-dashboard build",
    "build:backend": "pnpm --filter @stopfra/backend build",
    "preview": "pnpm --filter @stopfra/web-dashboard preview",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @stopfra/web-dashboard test:e2e",
    "test:backend": "pnpm --filter @stopfra/backend test",
    "db:migrate": "pnpm --filter @stopfra/backend migrate",
    "clean": "rm -rf node_modules apps/*/node_modules apps/fra-backend/backend/node_modules",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@types/react": ">=18.0.0"
      }
    },
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "esbuild": ">=0.25.0",
      "@remix-run/router": ">=7.7.0",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "ip-address@>=10.0.0 <10.3.1": "^10.3.1",
      "lodash@<4.18.0": "^4.18.0",
      "postcss@<8.5.18": "^8.5.18",
      "basic-ftp@<5.3.1": "^5.3.1"
    }
  }
}
