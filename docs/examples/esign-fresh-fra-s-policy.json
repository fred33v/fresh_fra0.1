{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSigningBucketProtection",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketLocation",
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::fresh-fra-s"
    },
    {
      "Sid": "ReadRetainedSigningVersions",
      "Effect": "Allow",
      "Action": ["s3:GetObjectVersion", "s3:GetObjectRetention", "s3:GetObjectLegalHold"],
      "Resource": "arn:aws:s3:::fresh-fra-s/esign/*"
    },
    {
      "Sid": "WriteProtectedSigningEvidence",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::fresh-fra-s/esign/*",
      "Condition": {
        "StringEquals": {
          "s3:object-lock-mode": "COMPLIANCE",
          "s3:object-lock-legal-hold": "ON",
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "SetEvidenceProtection",
      "Effect": "Allow",
      "Action": ["s3:PutObjectRetention", "s3:PutObjectLegalHold"],
      "Resource": "arn:aws:s3:::fresh-fra-s/esign/*"
    },
    {
      "Sid": "DenyEvidenceDeletionAndBypass",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention"],
      "Resource": "arn:aws:s3:::fresh-fra-s/esign/*"
    },
    {
      "Sid": "DenyClearingLegalHold",
      "Effect": "Deny",
      "Action": "s3:PutObjectLegalHold",
      "Resource": "arn:aws:s3:::fresh-fra-s/esign/*",
      "Condition": {
        "StringEquals": {
          "s3:object-lock-legal-hold": "OFF"
        }
      }
    }
  ]
}
