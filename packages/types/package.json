{
  "name": "@stopfra/types",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared TypeScript types for Stop FRA platform",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./assessment": {
      "import": "./src/assessment.ts",
      "types": "./src/assessment.ts"
    },
    "./auth": {
      "import": "./src/auth.ts",
      "types": "./src/auth.ts"
    },
    "./api": {
      "import": "./src/api.ts",
      "types": "./src/api.ts"
    },
    "./workshop": {
      "import": "./src/workshop.ts",
      "types": "./src/workshop.ts"
    },
    "./budget-guide": {
      "import": "./src/budget-guide.ts",
      "types": "./src/budget-guide.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "keywords": [
    "types",
    "typescript",
    "fraud-risk",
    "assessment",
    "stop-fra",
    "compliance"
  ],
  "author": "Stop FRA Team",
  "license": "MIT",
  "homepage": "https://github.com/stopfra/start-fra#readme",
  "bugs": {
    "url": "https://github.com/stopfra/start-fra/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stopfra/start-fra.git",
    "directory": "packages/types"
  }
}
