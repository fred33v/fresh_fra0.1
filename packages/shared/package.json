{
  "name": "@stopfra/shared",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared utilities, constants, and helpers for Stop FRA platform",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./constants": {
      "import": "./src/constants/index.ts",
      "types": "./src/constants/index.ts"
    },
    "./utils": {
      "import": "./src/utils/index.ts",
      "types": "./src/utils/index.ts"
    },
    "./logger": {
      "import": "./src/logger.ts",
      "types": "./src/logger.ts"
    },
    "./services": {
      "import": "./src/services/index.ts",
      "types": "./src/services/index.ts"
    },
    "./data": {
      "import": "./src/data/index.ts",
      "types": "./src/data/index.ts"
    }
  },
  "dependencies": {
    "@stopfra/types": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "keywords": [
    "fraud-risk",
    "assessment",
    "utilities",
    "shared",
    "stop-fra",
    "compliance"
  ],
  "author": "Stop FRA Team",
  "license": "MIT",
  "homepage": "https://github.com/stopfra/start-fra#readme",
  "bugs": {
    "url": "https://github.com/stopfra/start-fra/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stopfra/start-fra.git",
    "directory": "packages/shared"
  }
}
