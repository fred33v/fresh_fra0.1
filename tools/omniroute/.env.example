# OmniRoute settings for this project (a local AI gateway).
# `pnpm ai-gateway` copies this to tools/omniroute/.env on first run and fills in
# random secrets there. That .env file is ignored by git: never commit it.
# Every option OmniRoute supports is listed in its own .env.example
# (~/.local/node22/lib/node_modules/omniroute/.env.example).

# Required secrets (filled in automatically on first run)
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1
# First dashboard password; change it in Dashboard > Settings > Security after signing in
INITIAL_PASSWORD=

# Where OmniRoute keeps its database, logs and the provider API keys you add.
# Outside the project folder so they are never committed or deployed.
DATA_DIR=

# Only reachable from this computer
# OMNIROUTE_SERVER_HOST, not HOSTNAME: shells set HOSTNAME to the computer name
OMNIROUTE_SERVER_HOST=127.0.0.1
PORT=20128

# Apps must send an OmniRoute API key (create one in the dashboard under API Keys)
REQUIRE_API_KEY=true
